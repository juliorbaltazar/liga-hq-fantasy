# Gere um par com:  docker run --rm livekit/livekit-server generate-keys
LIVEKIT_API_KEY=APIxxxxxxxxxxxx
LIVEKIT_API_SECRET=troque-por-um-secret-longo-de-verdade

# Seus dominios (veja o README: DuckDNS e gratis)
SALA_DOMAIN=sala.SEUNOME.duckdns.org
WHIP_DOMAIN=whip.SEUNOME.duckdns.org

# Usado pelo token-service pra falar com o proprio LiveKit
LIVEKIT_HOST=https://sala.SEUNOME.duckdns.org

ROOM_NAME=sala-principal

# Depois que publicar o app, troque pela origem real (ex: https://juliorbaltazar.github.io)
ALLOWED_ORIGIN=*
