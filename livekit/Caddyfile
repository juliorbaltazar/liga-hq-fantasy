# TLS automático. Troque os dois domínios pelos seus (veja o README).
# O Caddy pede o certificado ao Let's Encrypt sozinho na primeira subida.

# --- sala: WebSocket do LiveKit + emissor de tokens ---
{$SALA_DOMAIN} {
	# O app do navegador chama esses dois pra entrar e pra pegar o endereço do OBS
	handle /api/* {
		reverse_proxy 127.0.0.1:8090
	}

	# Todo o resto é o LiveKit (o SDK usa /rtc e /validate)
	handle {
		reverse_proxy 127.0.0.1:7880
	}
}

# --- whip: entrada do OBS ---
# Subdomínio separado de propósito: o WHIP tem caminhos próprios e misturar
# com o roteamento do LiveKit é a forma mais fácil de quebrar os dois.
{$WHIP_DOMAIN} {
	reverse_proxy 127.0.0.1:8080
}
